# Set these as environment variables on the host (never commit real values).
# Neon connection string (use the pooled one).
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=
# Set at least one for the AI features. If both are set, Claude is used.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=8080
